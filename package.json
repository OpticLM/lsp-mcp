{
  "name": "lsp-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing a Language Server's capabilities to agents as a headless editor",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lsp-mcp": "./src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "check": "tsc",
    "test": "vitest run",
    "lint": "biome check --write --unsafe",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115",
    "vscode-languageserver-protocol": "^3.18.3",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.115",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vscode-languageserver": "^10.1.1"
  }
}
